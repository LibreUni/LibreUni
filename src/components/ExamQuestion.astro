---
import { getBlockById } from '../utils/statementRegistry.mjs';

interface Props {
  id: string;
  points: number;
  covers?: string[] | string;
  title?: string;
}

const { id, points, covers = [], title } = Astro.props;

const record = getBlockById(id);
const displayNumber = record?.number || '';
---

<div
  id={id}
  data-question-id={id}
  data-points={points}
  class="lu-exam-question bg-light-bg dark:bg-dark-surface p-6 rounded-xl border border-light-border dark:border-dark-border scroll-mt-24 not-prose my-8"
>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b border-light-border/60 dark:border-dark-border/60">
    <div class="flex items-center gap-2">
      <h3 class="font-bold text-lg m-0 text-light-text dark:text-dark-text">
        {displayNumber ? `Question ${displayNumber}` : 'Question'}
        {title ? `: ${title}` : ''}
        <span class="text-sm font-semibold text-primary ml-2">
          ({points} {points === 1 ? 'point' : 'points'})
        </span>
      </h3>
    </div>
  </div>
  <div class="lu-question-body prose prose-slate dark:prose-invert max-w-none text-base">
    <slot />
  </div>
</div>
