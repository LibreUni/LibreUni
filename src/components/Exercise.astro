---
import { getBlockById } from '../utils/statementRegistry.mjs';

export type ExerciseType =
  | 'verify'
  | 'negate'
  | 'construct'
  | 'describe'
  | 'example-or-impossible'
  | 'invented-definition'
  | 'generalise'
  | 'prove'
  | 'formalise'
  | 'tool';

export type ExerciseLevel = 'recall' | 'application' | 'transfer' | 'synthesis';

interface Props {
  id: string;
  type: ExerciseType;
  level?: ExerciseLevel;
  title: string;
  number?: string | number;
  challenge?: boolean;
}

const {
  id,
  type,
  level = 'application',
  title,
  number,
  challenge = false,
} = Astro.props;

const record = getBlockById(id);
const displayNumber = number || record?.number || '';

const TYPE_LABELS: Record<ExerciseType, string> = {
  verify: 'Verification',
  negate: 'Negation',
  construct: 'Construction',
  describe: 'Description',
  'example-or-impossible': 'Example / Impossible',
  'invented-definition': 'Perturbed Definition',
  generalise: 'Generalisation',
  prove: 'Proof',
  formalise: 'Formalisation',
  tool: 'Tool / Simulation',
};

const LEVEL_COLORS: Record<ExerciseLevel, string> = {
  recall: 'bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200',
  application: 'bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300',
  transfer: 'bg-purple-100 text-purple-800 dark:bg-purple-950/60 dark:text-purple-300',
  synthesis: 'bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300',
};
---

<div id={id} class="lu-exercise bg-light-bg dark:bg-dark-surface p-5 rounded-xl border border-light-border dark:border-dark-border scroll-mt-24 not-prose">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3 pb-2 border-b border-light-border/60 dark:border-dark-border/60">
    <div class="flex items-center gap-2">
      {challenge && (
        <span class="text-amber-500 font-black text-base" title="Challenge problem (★)" aria-label="Challenge problem">★</span>
      )}
      <h3 class="font-bold text-base m-0 text-light-text dark:text-dark-text">
        {displayNumber ? `Exercise ${displayNumber}: ` : 'Exercise: '}{title}
      </h3>
    </div>
    <div class="flex items-center gap-1.5 text-xs">
      <span class="rounded px-2 py-0.5 font-semibold bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300">
        {TYPE_LABELS[type] || type}
      </span>
      <span class={`rounded px-2 py-0.5 font-semibold ${LEVEL_COLORS[level] || ''}`}>
        {level}
      </span>
    </div>
  </div>
  <div class="lu-exercise-body prose prose-slate dark:prose-invert max-w-none text-base">
    <slot />
  </div>
</div>
