---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Deep Practice",
  description = "Solve these problems to test and consolidate your understanding. Complete worked solutions and diagnostic hints are available for each problem."
} = Astro.props;
---

<section class="lu-exercise-set mt-12 mb-8 pt-8 border-t-2 border-primary/20 not-prose" aria-labelledby="exercise-set-heading">
  <div class="mb-6">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center justify-center rounded-md bg-blue-100 dark:bg-blue-950/60 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-blue-800 dark:text-blue-300">
        Section Exercises
      </span>
      <h2 id="exercise-set-heading" class="m-0 text-2xl font-black tracking-tight text-light-text dark:text-dark-text">
        {title}
      </h2>
    </div>
    {description && (
      <p class="mt-2 text-sm text-light-muted dark:text-dark-muted leading-relaxed">
        {description}
      </p>
    )}
  </div>
  <div class="lu-exercise-set-list space-y-6">
    <slot />
  </div>
</section>
