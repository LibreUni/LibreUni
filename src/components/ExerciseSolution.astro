---
import katex from 'katex';

interface Props {
  hint?: string;
  title?: string;
  hintTitle?: string;
}

const { hint, title = 'Worked solution', hintTitle = 'Hint' } = Astro.props;
const hasHintSlot = Astro.slots.has('hint');

function renderHintMath(text: string): string {
  const escapeHtml = (str: string) =>
    str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

  // Match display math $$...$$ or inline math $...$
  const tokenRegex = /(\$\$[\s\S]+?\$\$|\$[^$\n]+\$)/g;
  const parts = text.split(tokenRegex);

  return parts
    .map((part) => {
      if (part.startsWith('$$') && part.endsWith('$$') && part.length > 4) {
        const tex = part.slice(2, -2);
        try {
          return katex.renderToString(tex, {
            displayMode: true,
            output: 'mathml',
            throwOnError: false,
          });
        } catch {
          return escapeHtml(part);
        }
      }
      if (part.startsWith('$') && part.endsWith('$') && part.length > 2) {
        const tex = part.slice(1, -1);
        try {
          return katex.renderToString(tex, {
            displayMode: false,
            output: 'mathml',
            throwOnError: false,
          });
        } catch {
          return escapeHtml(part);
        }
      }
      return escapeHtml(part);
    })
    .join('');
}

const renderedHint = hint ? renderHintMath(hint) : '';
const renderedTitle = renderHintMath(title);
const renderedHintTitle = renderHintMath(hintTitle);
---

<div class="exercise-solution-card not-prose my-5 space-y-2.5" data-component="ExerciseSolution">
  {(hint || hasHintSlot) && (
    <details class="exercise-hint lu-disclosure group overflow-hidden rounded-xl border border-light-border bg-light-surface/65 transition-colors dark:border-dark-border dark:bg-dark-surface/60">
      <summary class="lu-disclosure-summary">
        <span class="inline-flex items-center gap-2.5">
          <svg
            class="lu-chevron h-4 w-4 shrink-0 text-light-muted transition-transform duration-150 group-open:rotate-90 dark:text-dark-muted"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 5l6 5-6 5" />
          </svg>
          <span class="text-xs font-bold tracking-wide text-light-text dark:text-dark-text" set:html={renderedHintTitle} />
        </span>
        <span class="text-xs font-medium text-light-muted dark:text-dark-muted">
          <span class="group-open:hidden">Expand</span>
          <span class="hidden group-open:inline">Collapse</span>
        </span>
      </summary>
      <div class="border-t border-light-border/70 px-4 py-3 text-sm leading-relaxed text-light-text dark:border-dark-border/70 dark:text-dark-text">
        {hasHintSlot ? <slot name="hint" /> : <p class="m-0" set:html={renderedHint} />}
      </div>
    </details>
  )}

  <details class="exercise-solution lu-disclosure group overflow-hidden rounded-xl border border-primary/20 bg-primary/[0.025] transition-colors dark:border-primary/25 dark:bg-primary/[0.05]">
    <summary class="lu-disclosure-summary">
      <span class="inline-flex items-center gap-2.5">
        <svg
          class="lu-chevron h-4 w-4 shrink-0 text-primary transition-transform duration-150 group-open:rotate-90"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 5l6 5-6 5" />
        </svg>
        <span class="text-xs font-bold tracking-wide text-primary" set:html={renderedTitle} />
      </span>
      <span class="text-xs font-medium text-light-muted dark:text-dark-muted">
        <span class="group-open:hidden">Expand</span>
        <span class="hidden group-open:inline">Collapse</span>
      </span>
    </summary>
    <div class="exercise-solution-body prose prose-slate max-w-none border-t border-primary/15 px-4 py-3.5 text-sm leading-relaxed text-light-text dark:prose-invert dark:border-primary/20 dark:text-dark-text">
      <slot />
    </div>
  </details>
</div>
