---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  module?: string;
  prerequisites: string[];
  outcomes: string[];
  assessment?: string;
  omitted: string[];
  estimatedMinutes?: number;
  headings?: HeadingItem[];
}

const {
  module,
  prerequisites = [],
  outcomes = [],
  assessment,
  omitted = [],
  estimatedMinutes,
  headings = [],
} = Astro.props;

const sectionHeadings = headings.filter((h) => h.depth === 2);

const formatDuration = (minutes: number) => {
  if (minutes < 120) return `${minutes} min`;
  const hours = Math.floor(minutes / 60);
  const remainder = minutes % 60;
  return remainder ? `${hours} h ${remainder} min` : `${hours} h`;
};

const summaryParts = [
  module,
  estimatedMinutes ? formatDuration(estimatedMinutes) : undefined,
  outcomes.length === 1 ? '1 outcome' : `${outcomes.length} outcomes`,
].filter(Boolean);
---

<details class="lesson-brief lu-disclosure group">
  <summary class="lu-disclosure-summary">
    <span class="inline-flex items-center gap-2.5">
      <svg class="lu-chevron h-4 w-4 shrink-0 text-primary transition-transform duration-150 group-open:rotate-90" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 5l6 5-6 5" />
      </svg>
      <span class="lesson-brief-title">Lesson brief</span>
    </span>
    <span class="lesson-brief-meta">{summaryParts.join(' · ')}</span>
  </summary>

  <div class="lesson-brief-body">
    {prerequisites.length > 0 && (
      <section>
        <h2>Required knowledge</h2>
        <ul>{prerequisites.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}

    {outcomes.length > 0 && (
      <section>
        <h2>Learning outcomes</h2>
        <ul>{outcomes.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}

    {assessment && (
      <section class="lesson-brief-assessment">
        <h2>Assessment target</h2>
        <p>{assessment}</p>
      </section>
    )}

    {omitted.length > 0 && (
      <section>
        <h2>Scope boundary</h2>
        <ul>{omitted.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}
  </div>
</details>

{sectionHeadings.length > 1 && (
  <nav aria-label="On this page" class="lesson-toc mb-8 rounded-xl border border-light-border bg-light-surface/50 px-4 py-3 dark:border-dark-border dark:bg-dark-surface/40">
    <div class="mb-2 text-[11px] font-bold uppercase tracking-wider text-light-muted dark:text-dark-muted">On this page</div>
    <ol class="flex flex-wrap gap-x-3 gap-y-1 text-xs font-semibold">
      {sectionHeadings.map((h, idx) => (
        <li>
          <a href={`#${h.slug}`} class="inline-flex min-h-7 items-center gap-1.5 rounded-md px-2 py-1 text-light-text/80 transition-colors hover:bg-light-surface hover:text-primary dark:text-dark-text/80 dark:hover:bg-dark-surface dark:hover:text-primary">
            <span class="font-mono text-[10px] text-light-muted dark:text-dark-muted">{idx + 1}.</span>
            <span>{h.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
