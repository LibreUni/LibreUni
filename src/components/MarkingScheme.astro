---
interface Props {
  points?: number;
  class?: string;
}

const { points, class: className = '' } = Astro.props;
---

<div
  class={`lu-marking-scheme mt-6 rounded-xl border border-emerald-500/40 bg-emerald-50/70 dark:bg-emerald-950/30 p-5 text-sm not-prose ${className}`}
  data-marking-scheme
  hidden
>
  <div class="flex items-center justify-between font-bold text-emerald-900 dark:text-emerald-200 mb-3 pb-2 border-b border-emerald-500/20">
    <div class="flex items-center gap-2">
      <span class="rounded bg-emerald-500/20 px-2 py-0.5 text-xs font-black uppercase tracking-wider text-emerald-800 dark:text-emerald-300">
        Marking scheme
      </span>
      <span>Model answer and rubric</span>
    </div>
    {points && <span class="text-xs font-bold tabular-nums">{points} pts</span>}
  </div>
  <div class="prose prose-slate dark:prose-invert max-w-none text-sm text-light-text dark:text-dark-text">
    <slot />
  </div>
</div>
