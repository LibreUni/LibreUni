---
interface Props {
  id: string;
  for: string;
  title?: string;
  collapsible?: boolean;
  open?: boolean;
}

const {
  id,
  for: statementId,
  title = 'Proof',
  collapsible = false,
  // Collapsed proofs are an intentional exception for long or peripheral
  // material, so the safe default is closed.
  open = false,
} = Astro.props;

const headingId = `${id}-heading`;
const statementHref = `#${statementId}`;
---

<section id={id} class="math-proof not-prose my-5 scroll-mt-24 overflow-hidden rounded-xl border border-light-border bg-light-surface/60 dark:border-dark-border dark:bg-dark-surface/60" aria-labelledby={headingId}>
  {collapsible ? (
    <details open={open} class="lu-disclosure group">
      <summary id={headingId} class="lu-disclosure-summary">
        <span class="inline-flex items-center gap-2.5">
          <svg class="lu-chevron h-4 w-4 shrink-0 text-primary transition-transform duration-150 group-open:rotate-90" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 5l6 5-6 5" />
          </svg>
          <span class="text-xs font-extrabold uppercase tracking-wider text-light-text dark:text-dark-text">{title}</span>
        </span>
        <span class="text-xs font-medium text-light-muted dark:text-dark-muted">
          <span class="group-open:hidden">Expand proof</span>
          <span class="hidden group-open:inline">Collapse</span>
        </span>
      </summary>
      <div class="prose prose-slate max-w-none border-t border-light-border/70 px-4 py-3.5 text-sm leading-relaxed text-light-text dark:prose-invert dark:border-dark-border/70 dark:text-dark-text">
        <slot />
        <div class="mt-3 flex items-center justify-between border-t border-light-border/50 pt-2 not-prose dark:border-dark-border/50">
          <a href={statementHref} class="text-xs font-semibold text-primary no-underline hover:underline">Back to statement ↑</a>
          <span class="font-serif text-sm text-light-muted dark:text-dark-muted" title="End of proof" aria-label="End of proof">∎</span>
        </div>
      </div>
    </details>
  ) : (
    <div class="p-4 md:p-5">
      <div class="mb-2.5 flex flex-wrap items-center justify-between gap-3">
        <h3 id={headingId} class="m-0 text-xs font-extrabold uppercase tracking-wider text-light-text dark:text-dark-text">{title}</h3>
        <a href={statementHref} class="text-xs font-semibold text-primary no-underline hover:underline">Back to statement ↑</a>
      </div>
      <div class="prose prose-slate max-w-none text-sm leading-relaxed text-light-text dark:prose-invert dark:text-dark-text">
        <slot />
      </div>
      <div class="mt-2 flex justify-end">
        <span class="font-serif text-sm text-light-muted dark:text-dark-muted" title="End of proof" aria-label="End of proof">∎</span>
      </div>
    </div>
  )}
</section>
