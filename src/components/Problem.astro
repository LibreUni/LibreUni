---
import { getBlockById } from '../utils/statementRegistry.mjs';

export type ProblemType =
  | 'verify'
  | 'negate'
  | 'construct'
  | 'describe'
  | 'example-or-impossible'
  | 'invented-definition'
  | 'generalise'
  | 'prove'
  | 'formalise'
  | 'tool';

export type ProblemLevel = 'recall' | 'application' | 'transfer' | 'synthesis';

interface Props {
  id: string;
  type?: ProblemType;
  level?: ProblemLevel;
  title: string;
  challenge?: boolean;
  covers?: string[] | string;
}

const {
  id,
  type = 'transfer',
  level = 'transfer',
  title,
  challenge = false,
  covers = [],
} = Astro.props;

const record = getBlockById(id);
const displayNumber = record?.number || '';

const TYPE_LABELS: Record<ProblemType, string> = {
  verify: 'Verification',
  negate: 'Negation',
  construct: 'Construction',
  describe: 'Description',
  'example-or-impossible': 'Example / Impossible',
  'invented-definition': 'Perturbed Definition',
  generalise: 'Generalisation',
  prove: 'Proof',
  formalise: 'Formalisation',
  tool: 'Tool / Simulation',
};

const LEVEL_COLORS: Record<ProblemLevel, string> = {
  recall: 'bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200',
  application: 'bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300',
  transfer: 'bg-purple-100 text-purple-800 dark:bg-purple-950/60 dark:text-purple-300',
  synthesis: 'bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300',
};
---

<div
  id={id}
  data-problem-id={id}
  data-level={level}
  data-type={type}
  data-challenge={String(challenge)}
  class="lu-problem bg-light-bg dark:bg-dark-surface p-5 sm:p-6 rounded-xl border border-light-border dark:border-dark-border scroll-mt-24 not-prose transition-all"
>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b border-light-border/60 dark:border-dark-border/60">
    <div class="flex items-center gap-2">
      {challenge && (
        <span class="text-amber-500 font-black text-lg leading-none" title="Challenge problem (★)" aria-label="Challenge problem">★</span>
      )}
      <h3 class="font-bold text-base sm:text-lg m-0 text-light-text dark:text-dark-text">
        {displayNumber ? `Problem ${displayNumber}: ` : 'Problem: '}{title}
      </h3>
    </div>
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded px-2.5 py-1 font-semibold bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300">
        {TYPE_LABELS[type] || type}
      </span>
      <span class={`rounded px-2.5 py-1 font-semibold ${LEVEL_COLORS[level] || ''}`}>
        {level}
      </span>
      <button
        type="button"
        class="lu-problem-solve-btn inline-flex items-center gap-1.5 rounded-lg border border-light-border dark:border-dark-border px-2.5 py-1 font-semibold text-light-muted dark:text-dark-muted hover:text-emerald-700 dark:hover:text-emerald-400 hover:border-emerald-500/50 transition-colors"
        data-action="toggle-solved"
        aria-pressed="false"
      >
        <span class="solve-icon" aria-hidden="true">○</span>
        <span class="solve-text">Solved</span>
      </button>
    </div>
  </div>
  <div class="lu-problem-body prose prose-slate dark:prose-invert max-w-none text-base">
    <slot />
  </div>
</div>

<script>
  function setupProblemButtons() {
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const lessonsIdx = pathParts.indexOf('lessons');
    const courseId = (lessonsIdx >= 0 ? pathParts[lessonsIdx + 1] : pathParts.at(-2)) || 'course';

    document.querySelectorAll<HTMLElement>('.lu-problem').forEach((problemEl) => {
      const problemId = problemEl.dataset.problemId;
      if (!problemId) return;
      const btn = problemEl.querySelector<HTMLButtonElement>('.lu-problem-solve-btn');
      if (!btn) return;

      const storageKey = `problem-solved-${courseId}-${problemId}`;

      const updateState = (isSolved: boolean) => {
        btn.setAttribute('aria-pressed', String(isSolved));
        const icon = btn.querySelector('.solve-icon');
        if (isSolved) {
          btn.classList.remove('text-light-muted', 'dark:text-dark-muted');
          btn.classList.add('bg-emerald-500/10', 'border-emerald-500/40', 'text-emerald-700', 'dark:text-emerald-300');
          if (icon) icon.textContent = '●';
        } else {
          btn.classList.remove('bg-emerald-500/10', 'border-emerald-500/40', 'text-emerald-700', 'dark:text-emerald-300');
          btn.classList.add('text-light-muted', 'dark:text-dark-muted');
          if (icon) icon.textContent = '○';
        }
      };

      const saved = localStorage.getItem(storageKey) === 'true';
      updateState(saved);

      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const current = btn.getAttribute('aria-pressed') === 'true';
        const next = !current;
        localStorage.setItem(storageKey, String(next));
        updateState(next);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProblemButtons);
  } else {
    setupProblemButtons();
  }
</script>
