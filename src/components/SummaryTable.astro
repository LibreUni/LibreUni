---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Core Invariants & Theorems Summary",
  description = "A reference summary of the formal definitions, theorems, and invariants established in this module."
} = Astro.props;
---

<div class="lu-card-tier1 lu-summary-table my-8 p-6 rounded-xl border border-light-border dark:border-dark-border not-prose">
  <div class="mb-4">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center justify-center rounded-md bg-emerald-500/10 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
        Reference Sheet
      </span>
      <h3 class="m-0 text-xl font-bold tracking-tight text-light-text dark:text-dark-text">
        {title}
      </h3>
    </div>
    {description && (
      <p class="mt-1 text-sm text-light-muted dark:text-dark-muted">
        {description}
      </p>
    )}
  </div>
  <div class="overflow-x-auto">
    <slot />
  </div>
</div>
