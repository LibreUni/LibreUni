---
import Layout from '../layouts/Layout.astro';
import { ArrowRight, BookOpen, Home } from 'lucide-react';
---

<Layout
  title="Page Not Found - LibreUni"
  description="The requested LibreUni page could not be found."
>
  <main class="flex-1 bg-light-bg dark:bg-dark-bg px-6 py-24 md:px-8 md:py-32">
    <div class="mx-auto max-w-2xl rounded-2xl border border-light-border bg-white p-8 text-center dark:border-dark-border dark:bg-dark-surface md:p-12">
      <p class="mb-3 text-xs font-black uppercase tracking-[0.25em] text-primary">404</p>
      <h1 class="text-4xl font-black tracking-tight text-light-text dark:text-dark-text md:text-5xl">
        Page not found
      </h1>
      <p class="mt-4 text-base font-medium leading-relaxed text-light-muted dark:text-dark-muted">
        The address you requested does not match a published course, lesson, or roadmap page.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href={import.meta.env.BASE_URL}
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-bold text-primary-foreground transition-colors hover:bg-primary-dark"
        >
          <Home size={18} />
          Home
        </a>
        <a
          href={`${import.meta.env.BASE_URL}courses`}
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-light-border bg-light-surface px-6 py-3 text-sm font-bold text-light-text transition-colors hover:border-primary hover:text-primary dark:border-dark-border dark:bg-dark-bg dark:text-dark-text"
        >
          <BookOpen size={18} />
          Browse Courses
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </main>
</Layout>
