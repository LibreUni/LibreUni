---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getCourseLessons } from '../../utils/lessons';

export async function getStaticPaths() {
  return (await getCollection('careers')).map(career => ({
    params: { careerId: career.id },
    props: { career },
  }));
}

const { career } = Astro.props;
const base = import.meta.env.BASE_URL;
const courseEntries = await getCollection('courses');

const steps = await Promise.all(career.data.steps.map(async step => ({
  ...step,
  courses: await Promise.all(step.courses.map(async reference => {
    const course = courseEntries.find(entry => entry.id === reference.id);
    if (!course || course.data.status !== 'public') {
      throw new Error(`Path ${career.id} references unavailable course ${reference.id}`);
    }
    const lessons = await getCourseLessons(course.id);
    return {
      ...reference,
      title: course.data.title,
      firstLesson: lessons[0]?.id,
      count: lessons.length,
      hours: lessons.reduce((sum, lesson) => sum + (lesson.data.estimatedMinutes || 0), 0) / 60,
    };
  })),
})));

const totalCourseHours = steps.reduce(
  (sum, step) => sum + step.courses.reduce((subtotal, course) => subtotal + course.hours, 0),
  0,
);
---

<Layout title={`${career.data.title} Study Roadmap - LibreUni`}>
  <main class="mx-auto w-full min-w-0 max-w-5xl flex-1 px-5 py-10 sm:px-8 sm:py-16">
    <header class="border-b border-light-border pb-10 dark:border-dark-border">
      <a href={`${base}careers`} class="inline-flex min-h-11 items-center text-sm font-semibold text-primary">
        ← All career roadmaps
      </a>
      <p class="mt-4 text-xs font-bold uppercase tracking-widest text-primary">
        Career Study Guide · {career.data.role}
      </p>
      <h1 class="mt-3 text-4xl font-black leading-tight tracking-tight sm:text-5xl">
        {career.data.title}
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-light-muted dark:text-dark-muted">
        {career.data.description}
      </p>

      <div class="mt-6 flex flex-wrap gap-3 text-xs font-bold uppercase tracking-wider text-light-muted dark:text-dark-muted">
        <span class="rounded-lg border border-light-border bg-light-surface px-3 py-1.5 dark:border-dark-border dark:bg-dark-surface">
          {career.data.languages.length} Core Languages
        </span>
        <span class="rounded-lg border border-light-border bg-light-surface px-3 py-1.5 dark:border-dark-border dark:bg-dark-surface">
          {career.data.skillPillars.length} Skill Domains
        </span>
        <span class="rounded-lg border border-light-border bg-light-surface px-3 py-1.5 dark:border-dark-border dark:bg-dark-surface">
          {career.data.readingList.length} Essential Texts
        </span>
        <span class="rounded-lg border border-light-border bg-light-surface px-3 py-1.5 dark:border-dark-border dark:bg-dark-surface">
          {steps.length} LibreUni Courses ({totalCourseHours.toLocaleString('en-US', { maximumFractionDigits: 1 })}h)
        </span>
      </div>

      <div class="mt-6 rounded-2xl border border-light-border bg-light-surface/70 p-5 dark:border-dark-border dark:bg-dark-surface/60">
        <h2 class="text-xs font-bold uppercase tracking-widest text-primary">How to use this roadmap</h2>
        <p class="mt-2 text-sm leading-relaxed text-light-text dark:text-dark-text">
          {career.data.scope}
        </p>
      </div>

      <nav aria-label="Roadmap sections" class="mt-6 flex flex-wrap gap-3">
        <a href="#languages" class="assessment-action-primary inline-flex">
          Languages to Focus On
        </a>
        <a href="#skills" class="assessment-action-secondary inline-flex">
          Core Skills
        </a>
        <a href="#reading-list" class="assessment-action-secondary inline-flex">
          What to Read
        </a>
        <a href="#roadmap" class="assessment-action-secondary inline-flex">
          Study Sequence
        </a>
      </nav>
    </header>

    <section id="languages" class="scroll-mt-24 py-12" aria-labelledby="languages-heading">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-primary">1 · Tooling &amp; Languages</p>
        <h2 id="languages-heading" class="mt-2 text-3xl font-black tracking-tight">
          Programming languages to focus on
        </h2>
        <p class="mt-3 leading-relaxed text-light-muted dark:text-dark-muted">
          Do not collect programming languages for resume keywords. Master a small, orthogonal set where each language teaches a distinct layer of computing—from raw memory addresses to declarative relational queries and concurrent network services.
        </p>
      </div>

      <div class="mt-8 space-y-6">
        {career.data.languages.map(lang => (
          <article class="rounded-2xl border border-light-border bg-white p-6 dark:border-dark-border dark:bg-dark-surface sm:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-light-border pb-4 dark:border-dark-border">
              <h3 class="text-2xl font-black tracking-tight text-light-text dark:text-dark-text">
                {lang.name}
              </h3>
              <span class="text-xs font-bold uppercase tracking-widest text-primary">
                {lang.role}
              </span>
            </div>

            <p class="mt-4 leading-relaxed text-light-text dark:text-dark-text">
              {lang.whyItMatters}
            </p>

            <div class="mt-5">
              <h4 class="text-xs font-bold uppercase tracking-widest text-light-muted dark:text-dark-muted">
                Core concepts to master
              </h4>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-light-text dark:text-dark-text">
                {lang.coreTopics.map(topic => <li>{topic}</li>)}
              </ul>
            </div>

            <div class="mt-5 rounded-xl border border-light-border bg-light-surface/60 p-4 dark:border-dark-border dark:bg-dark-bg/60">
              <p class="text-xs font-bold uppercase tracking-widest text-light-muted dark:text-dark-muted">
                Common trap to avoid
              </p>
              <p class="mt-1.5 text-sm leading-relaxed text-light-muted dark:text-dark-muted">
                {lang.avoidTraps}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="skills" class="scroll-mt-24 border-t border-light-border py-12 dark:border-dark-border" aria-labelledby="skills-heading">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-primary">2 · Technical Capabilities</p>
        <h2 id="skills-heading" class="mt-2 text-3xl font-black tracking-tight">
          Core skills to acquire
        </h2>
        <p class="mt-3 leading-relaxed text-light-muted dark:text-dark-muted">
          Frameworks and APIs change every few years; the underlying invariants of algorithms, hardware execution, storage engines, and modular design do not. Focus your study on these four pillars.
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        {career.data.skillPillars.map(pillar => (
          <article id={pillar.id} class="flex flex-col rounded-2xl border border-light-border bg-white p-6 dark:border-dark-border dark:bg-dark-surface sm:p-7">
            <h3 class="text-xl font-bold text-light-text dark:text-dark-text">
              {pillar.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-light-muted dark:text-dark-muted">
              {pillar.summary}
            </p>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-light-text dark:text-dark-text">
              {pillar.skills.map(skill => <li>{skill}</li>)}
            </ul>
            <div class="mt-auto pt-5">
              <div class="rounded-xl border border-light-border bg-light-surface/60 p-4 dark:border-dark-border dark:bg-dark-bg/60">
                <p class="text-xs font-bold uppercase tracking-widest text-primary">
                  Deliberate practice
                </p>
                <p class="mt-1 text-xs leading-relaxed text-light-muted dark:text-dark-muted">
                  {pillar.practiceFocus}
                </p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="reading-list" class="scroll-mt-24 border-t border-light-border py-12 dark:border-dark-border" aria-labelledby="reading-heading">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-primary">3 · Canonical Literature</p>
        <h2 id="reading-heading" class="mt-2 text-3xl font-black tracking-tight">
          What to read
        </h2>
        <p class="mt-3 leading-relaxed text-light-muted dark:text-dark-muted">
          Short blog posts and video tutorials rarely build deep mental models. Read these foundational books and open curricula slowly, work through their exercises by hand, and test their claims in code.
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        {career.data.readingList.map(book => (
          <article class="flex flex-col rounded-2xl border border-light-border bg-white p-6 dark:border-dark-border dark:bg-dark-surface">
            <p class="text-xs font-bold uppercase tracking-widest text-primary">
              {book.category}
            </p>
            <h3 class="mt-2 text-lg font-bold leading-snug text-light-text dark:text-dark-text">
              {book.title}
            </h3>
            <p class="mt-1 text-xs font-semibold text-light-muted dark:text-dark-muted">
              {book.authors}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-light-text dark:text-dark-text">
              {book.whyRead}
            </p>
            <div class="mt-auto pt-4">
              <p class="text-xs leading-relaxed text-light-muted dark:text-dark-muted">
                <strong class="font-bold text-light-text dark:text-dark-text">Priority focus:</strong> {book.focusChapters}
              </p>
              {book.link && (
                <a
                  href={book.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary underline underline-offset-4"
                >
                  Open free online edition ↗
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="roadmap" class="scroll-mt-24 border-t border-light-border py-12 dark:border-dark-border" aria-labelledby="sequence-heading">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-primary">4 · Staged Study Sequence</p>
        <h2 id="sequence-heading" class="mt-2 text-3xl font-black tracking-tight">
          How to sequence your study
        </h2>
        <p class="mt-3 leading-relaxed text-light-muted dark:text-dark-muted">
          Follow these four stages to connect LibreUni's interactive courses with external reading and programming practice. Each stage builds the mental models assumed by the next layer of the stack.
        </p>
      </div>

      <ol class="mt-8 space-y-8">
        {steps.map((step, index) => (
          <li id={step.id} class="scroll-mt-24 rounded-2xl border border-light-border bg-light-surface p-6 dark:border-dark-border dark:bg-dark-surface sm:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="text-xs font-bold uppercase tracking-widest text-primary">
                Stage {index + 1}
              </p>
              <div class="flex flex-wrap gap-2">
                {step.languagesUsed.map(lang => (
                  <span class="rounded-lg border border-light-border bg-white px-2.5 py-1 text-xs font-semibold text-light-text dark:border-dark-border dark:bg-dark-bg dark:text-dark-text">
                    {lang}
                  </span>
                ))}
              </div>
            </div>

            <h3 class="mt-2 text-2xl font-bold text-light-text dark:text-dark-text">
              {step.title}
            </h3>
            <p class="mt-3 leading-relaxed text-light-text dark:text-dark-text">
              {step.outcome}
            </p>

            <div class="mt-6">
              <h4 class="text-xs font-bold uppercase tracking-widest text-light-muted dark:text-dark-muted">
                LibreUni Course in this Stage
              </h4>
              {step.courses.map(course => (
                <div class="mt-3 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-light-border bg-white p-4 dark:border-dark-border dark:bg-dark-bg">
                  <div>
                    <a href={`${base}courses/${course.id}`} class="text-lg font-bold text-primary underline underline-offset-4">
                      {course.title}
                    </a>
                    <p class="mt-1 text-xs text-light-muted dark:text-dark-muted">
                      {course.count} lessons · {course.hours.toLocaleString('en-US', { maximumFractionDigits: 1 })} planned study hours
                    </p>
                  </div>
                  <div class="flex flex-wrap gap-3">
                    <a href={`${base}lessons/${course.firstLesson}`} class="assessment-action-primary inline-flex">
                      Start course
                    </a>
                    <a href={`${base}lessons/${step.capstoneFocus.lesson}`} class="assessment-action-secondary inline-flex">
                      Capstone &amp; practice
                    </a>
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-6">
              <h4 class="text-xs font-bold uppercase tracking-widest text-light-muted dark:text-dark-muted">
                Complementary External Study &amp; Practice
              </h4>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-light-text dark:text-dark-text">
                {step.externalStudy.map(item => <li>{item}</li>)}
              </ul>
            </div>

            <p class="mt-5 text-xs leading-relaxed text-light-muted dark:text-dark-muted">
              <strong class="font-bold text-light-text dark:text-dark-text">Stage milestone:</strong> {step.capstoneFocus.summary}
            </p>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Layout>
