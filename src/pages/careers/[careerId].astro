---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LearningPathEvidence from '../../components/LearningPathEvidence';
import { getCourseLessons } from '../../utils/lessons';

export async function getStaticPaths() {
  return (await getCollection('careers')).map(career => ({ params: { careerId: career.id }, props: { career } }));
}
const { career } = Astro.props;
const base = import.meta.env.BASE_URL;
const courseEntries = await getCollection('courses');
const steps = await Promise.all(career.data.steps.map(async step => ({
  ...step,
  courses: await Promise.all(step.courses.map(async reference => {
    const course = courseEntries.find(entry => entry.id === reference.id);
    if (!course || course.data.status !== 'public') throw new Error(`Path ${career.id} references unavailable course ${reference.id}`);
    const lessons = await getCourseLessons(course.id);
    return { ...reference, title: course.data.title, firstLesson: lessons[0]?.id, count: lessons.length, hours: lessons.reduce((sum, lesson) => sum + (lesson.data.estimatedMinutes || 0), 0) / 60 };
  })),
})));
const hours = steps.reduce((sum, step) => sum + step.courses.reduce((subtotal, course) => subtotal + course.hours, 0), 0);
const gates = [...steps.map(step => ({ id: step.id, title: step.title })), { id: 'synthesis', title: career.data.synthesis.title }];
---

<Layout title={`${career.data.title} - LibreUni Learning Path`}>
  <main class="mx-auto w-full min-w-0 max-w-5xl flex-1 px-5 py-10 sm:px-8 sm:py-16">
    <header class="border-b border-light-border pb-10 dark:border-dark-border">
      <a href={`${base}careers`} class="inline-flex min-h-11 items-center text-sm font-semibold text-primary">← All learning paths</a>
      <p class="mt-6 text-xs font-bold uppercase tracking-widest text-primary">Learning path · systems foundations</p>
      <h1 class="mt-3 text-4xl font-black leading-tight tracking-tight sm:text-5xl">{career.data.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-light-muted dark:text-dark-muted">{career.data.description}</p>
      <p class="mt-4 text-sm font-semibold">{steps.length} courses · {hours.toLocaleString('en-US', { maximumFractionDigits: 1 })} planned course hours + {career.data.synthesis.estimatedHours} synthesis hours</p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-light-muted dark:text-dark-muted">{career.data.scope}</p>
      <a href="#entry-checks" class="assessment-action-primary mt-6 inline-flex">Check your preparation</a>
    </header>

    <section id="entry-checks" class="scroll-mt-24 py-10" aria-labelledby="entry-heading">
      <h2 id="entry-heading" class="text-2xl font-bold">Before you begin</h2>
      <p class="mt-3 leading-relaxed text-light-muted dark:text-dark-muted">Try these tasks unaided, then compare your reasoning with the criteria. They are a diagnostic sample, not a placement exam. If you cannot produce the evidence, use the preparation resources before attempting the course labs.</p>
      <div class="mt-6 space-y-4">
        {career.data.entryChecks.map(check => <div class="rounded-xl border border-light-border p-5 dark:border-dark-border">
          <p class="leading-relaxed">{check.prompt}</p>
          <details class="mt-4"><summary class="min-h-11 cursor-pointer py-2 font-semibold text-primary">Compare with the readiness criteria</summary><p class="mt-2 leading-relaxed text-light-muted dark:text-dark-muted">{check.criteria}</p></details>
        </div>)}
      </div>
      <h3 class="mt-8 text-lg font-bold">Preparation resources</h3>
      <ul class="mt-4 space-y-4">{career.data.preparation.map(resource => <li><a class="font-semibold text-primary underline underline-offset-4" href={resource.link} target="_blank" rel="noopener noreferrer">{resource.title} ↗</a><p class="mt-1 text-sm leading-relaxed text-light-muted dark:text-dark-muted">{resource.description}</p></li>)}</ul>
    </section>

    <section aria-labelledby="sequence-heading" class="border-t border-light-border py-10 dark:border-dark-border">
      <h2 id="sequence-heading" class="text-2xl font-bold">Study, produce evidence, seek review</h2>
      <p class="mt-3 text-light-muted dark:text-dark-muted">Each course has its own exercises and capstone. The gates below name the evidence to defend before extending your model at the next layer. Reading completion remains separate from assessment.</p>
      <ol class="mt-8 space-y-8">{steps.map((step, index) => <li id={step.id} class="scroll-mt-24 rounded-2xl border border-light-border bg-light-surface p-5 dark:border-dark-border dark:bg-dark-surface sm:p-8">
        <p class="text-xs font-bold uppercase tracking-widest text-primary">Stage {index + 1}</p>
        <h3 class="mt-2 text-2xl font-bold">{step.title}</h3>
        <p class="mt-3 leading-relaxed">{step.outcome}</p>
        {step.courses.map(course => <div class="my-5 flex flex-wrap items-center gap-3">
          <a href={`${base}courses/${course.id}`} class="font-bold text-primary underline underline-offset-4">{course.title}</a>
          <span class="text-sm text-light-muted dark:text-dark-muted">{course.count} lessons · {course.hours.toLocaleString('en-US', { maximumFractionDigits: 1 })} planned hours</span>
          <a href={`${base}lessons/${course.firstLesson}`} class="assessment-action-secondary">Start course</a>
        </div>)}
        <h4 class="font-bold">Assessment gate</h4>
        <p class="mt-2 text-sm leading-relaxed">{step.gate.prompt}</p>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed">{step.gate.criteria.map(criterion => <li>{criterion}</li>)}</ul>
        <a href={`${base}lessons/${step.gate.lesson}`} class="mt-5 inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4">Open the assignment and rubric →</a>
      </li>)}</ol>
    </section>

    <section id="synthesis" class="scroll-mt-24 border-t border-light-border py-10 dark:border-dark-border" aria-labelledby="synthesis-heading">
      <p class="text-xs font-bold uppercase tracking-widest text-primary">Cross-course synthesis</p>
      <h2 id="synthesis-heading" class="mt-2 text-2xl font-bold">{career.data.synthesis.title}</h2>
      <p class="mt-4 leading-relaxed">{career.data.synthesis.brief}</p>
      <h3 class="mt-6 text-lg font-bold">Required evidence</h3>
      <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed">{career.data.synthesis.deliverables.map(item => <li>{item}</li>)}</ul>
      <h3 class="mt-6 text-lg font-bold">Review criteria</h3>
      <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed">{career.data.synthesis.criteria.map(item => <li>{item}</li>)}</ul>
      <p class="mt-6 text-sm leading-relaxed text-light-muted dark:text-dark-muted">{career.data.synthesis.boundary}</p>
    </section>
    <LearningPathEvidence client:load pathId={career.id} gates={gates} />
  </main>
</Layout>
