---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const paths = await getCollection('careers');
---
<Layout title="Learning Paths - LibreUni">
  <main class="mx-auto w-full min-w-0 max-w-5xl flex-1 px-5 py-12 sm:px-8 sm:py-20">
    <header class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-primary">Learning paths</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">Connect the mechanisms.</h1>
      <p class="mt-5 text-lg leading-relaxed text-light-muted dark:text-dark-muted">A path should tell you what preparation is needed, which evidence to produce, and how to challenge your understanding. The reference path brings three courses together without claiming a complete degree or professional qualification.</p>
    </header>
    <section class="mt-10 space-y-6" aria-label="Available learning paths">
      {paths.map(path => <a href={`${import.meta.env.BASE_URL}careers/${path.id}`} class="group block rounded-2xl border border-light-border bg-white p-6 transition-colors hover:border-primary dark:border-dark-border dark:bg-dark-surface sm:p-8">
        <p class="text-xs font-bold uppercase tracking-widest text-primary">{path.data.steps.length} courses · preparation · assessment · synthesis</p>
        <h2 class="mt-3 text-2xl font-bold group-hover:text-primary">{path.data.title}</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-light-muted dark:text-dark-muted">{path.data.description}</p>
        <p class="mt-6 font-semibold text-primary">Inspect the learning contract →</p>
      </a>)}
    </section>
  </main>
</Layout>
