---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const paths = await getCollection('careers');
---
<Layout title="Career & Study Roadmaps - LibreUni">
  <main class="mx-auto w-full min-w-0 max-w-5xl flex-1 px-5 py-12 sm:px-8 sm:py-20">
    <header class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-primary">Career &amp; Study Roadmaps</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">What to study, what to read, and which skills to build.</h1>
      <p class="mt-5 text-lg leading-relaxed text-light-muted dark:text-dark-muted">
        A single course catalog is only part of becoming an engineer. Each career guide maps out the programming languages to focus on, the core technical skills to acquire, the canonical books worth reading, and how LibreUni's courses connect to broader study.
      </p>
    </header>
    <section class="mt-10 space-y-6" aria-label="Available career roadmaps">
      {paths.map(path => (
        <a href={`${import.meta.env.BASE_URL}careers/${path.id}`} class="group block rounded-2xl border border-light-border bg-white p-6 transition-colors hover:border-primary dark:border-dark-border dark:bg-dark-surface sm:p-8">
          <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-widest text-primary">
            <span>{path.data.role}</span>
            <span>·</span>
            <span>{path.data.languages.length} core languages</span>
            <span>·</span>
            <span>{path.data.readingList.length} essential texts</span>
            <span>·</span>
            <span>{path.data.steps.length} study stages</span>
          </div>
          <h2 class="mt-3 text-2xl font-bold group-hover:text-primary sm:text-3xl">{path.data.title}</h2>
          <p class="mt-3 max-w-3xl leading-relaxed text-light-muted dark:text-dark-muted">{path.data.description}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {path.data.languages.map(lang => (
              <span class="rounded-lg border border-light-border bg-light-surface px-2.5 py-1 text-xs font-semibold text-light-text dark:border-dark-border dark:bg-dark-bg dark:text-dark-text">
                {lang.name}
              </span>
            ))}
          </div>
          <p class="mt-6 font-semibold text-primary">Explore the complete study roadmap →</p>
        </a>
      ))}
    </section>
  </main>
</Layout>
